---
import '../styles/global.css';
const { title, description } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} | AI Tools Weekly</title>
  <meta name="description" content={description} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <script is:inline>
    document.addEventListener('error', function(e) {
      var img = e.target;
      if (img.tagName === 'IMG' && img.classList.contains('tool-logo')) {
        img.onerror = null;
        var name = img.alt || 'Tool';
        var initial = name.charAt(0).toUpperCase();
        var palette = ['3b82f6','10b981','8b5cf6','f97316','14b8a6','f59e0b','ec4899'];
        var color = palette[name.charCodeAt(0) % palette.length];
        var svg = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 36 36"><rect width="36" height="36" rx="8" fill="#' + color + '"/><text x="18" y="25" font-family="system-ui,sans-serif" font-size="17" font-weight="700" fill="white" text-anchor="middle">' + initial + '</text></svg>';
        img.src = 'data:image/svg+xml;base64,' + btoa(svg);
      }
    }, true);
  </script>
</head>
<body>
  <header>
    <nav>
      <a href="/" class="logo">AI Tools Weekly</a>
      <div class="nav-links">
        <a href="/tools">All Tools</a>
        <a href="/archive">Archive</a>
        <a href="/about">About</a>
      </div>
    </nav>
  </header>
  <main>
    <slot />
  </main>
  <footer>
    <p>AI Tools Weekly — curated by AI, for small business owners.</p>
    <p><a href="/about">About</a> · <a href="mailto:hello@aitoolsweekly.com">Contact</a></p>
  </footer>
</body>
</html>
