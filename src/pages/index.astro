---
import Base from '../layouts/Base.astro';
import tools from '../../data/tools.json';
import { getLatestIssue } from '../lib/issues.js';

const featuredTools = tools.filter(t => t.featured).slice(0, 6);
const latestIssue = await getLatestIssue();

const categories = [...new Set(tools.map(t => t.category))];
const categoryCounts = Object.fromEntries(
  categories.map(c => [c, tools.filter(t => t.category === c).length])
);
---

<Base title="Home" description="Weekly digest of the best new AI tools for small business owners.">

  <!-- ── HERO ─────────────────────────────────────────────────── -->
  <div class="hero">
    <canvas id="neural-canvas" aria-hidden="true"></canvas>
    <div class="hero-grid">
      <div class="hero-text">
        <div class="badge">Free · Every Monday · No spam</div>
        <h1>The best new AI tools,<br/><span>delivered every Monday</span></h1>
        <p>We track hundreds of AI tools so small business owners don't have to. One tight email, one link to click.</p>
        <div class="hero-ctas">
          <a href="#subscribe" class="btn btn-primary">Subscribe free →</a>
          <a href="/tools" class="btn btn-ghost">Browse {tools.length} tools</a>
        </div>
        <div class="hero-stats">
          <span>{tools.length} tools reviewed</span>
          <span>Updated weekly</span>
          <span>Free forever</span>
        </div>
      </div>

