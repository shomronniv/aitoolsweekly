    <section>
      <h2>Latest issue</h2>
      <div class="issue-card">
        <div>
          <div class="issue-date">{latestIssue.date}</div>
          <div class="issue-title">{latestIssue.subject}</div>
          <div class="issue-preview">{latestIssue.preview}</div>
        </div>
        <a href={`/archive#${latestIssue.date}`} class="btn btn-secondary" style="white-space:nowrap">Read →</a>
      </div>
    </section>
  )}

  <!-- ── CATEGORY OVERVIEW ─────────────────────────────────────── -->
  <section>
    <h2>Browse by category</h2>
    <div class="category-grid">
      {Object.entries(categoryCounts).map(([cat, count]) => (
        <a href={`/tools?category=${encodeURIComponent(cat)}`} class="category-pill" data-cat={cat}>
          <span class="category-pill-dot"></span>
          <span class="category-pill-name">{cat}</span>
          <span class="category-pill-count">{count}</span>
        </a>
      ))}
    </div>
  </section>

  <!-- ── FEATURED TOOLS ────────────────────────────────────────── -->
  <section>
    <div style="display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:0.5rem">
      <h2 style="margin:0">Featured tools this week</h2>
      <a href="/tools" style="font-size:0.875rem;color:#6366f1;text-decoration:none;font-weight:600">Browse all {tools.length} →</a>
    </div>
    <div class="tools-grid">
      {featuredTools.map(tool => (
        <div class="tool-card" data-cat={tool.category}>
          <div class="tool-card-header">
            <img src={tool.logo} alt={tool.name} class="tool-logo" loading="lazy" />
            <div>
              <div class="tool-name">{tool.name}</div>
              <div class="tool-category">{tool.category}</div>
            </div>
          </div>
          <p class="tool-tagline">{tool.tagline}</p>
          <p class="tool-pricing">{tool.pricing}</p>
          <div style="display:flex;gap:0.5rem">
            <a href={`/tools/${tool.slug}`} class="btn btn-secondary" style="font-size:0.8rem;padding:0.4rem 0.9rem">Details</a>
            <a href={tool.affiliateUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary" style="font-size:0.8rem;padding:0.4rem 0.9rem">Try free →</a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ── SUBSCRIBE ─────────────────────────────────────────────── -->
  <div class="subscribe-box" id="subscribe">
    <h2>Get next week's digest</h2>
    <p>Join small business owners getting smarter about AI every Monday. Free. Unsubscribe in one click.</p>
    <form class="subscribe-form" name="subscribe" method="POST" data-netlify="true">
      <input type="hidden" name="form-name" value="subscribe" />
      <input type="email" name="email" placeholder="your@email.com" required />
      <button type="submit" class="btn btn-primary">Subscribe</button>
    </form>
    <p style="margin-top:1rem;font-size:0.75rem;color:#3d4460">No spam. No selling your email. Unsubscribe anytime.</p>
  </div>

</Base>

<style>
/* ── Neural canvas ─────────────────────────────────────────────── */
#neural-canvas {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  border-radius: 20px;
  z-index: 0;
  pointer-events: none;
}

/* ── How it works ──────────────────────────────────────────────── */
.how-section {
  margin-bottom: 3.5rem;
  padding: 2.5rem;
  background: var(--bg-card);
  border-radius: 16px;
  border: 1px solid var(--border);
}

.how-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2rem;
}

.how-item h3 { margin-top: 0.75rem; margin-bottom: 0.4rem; font-size: 1rem; color: var(--text); }
.how-item p  { font-size: 0.875rem; color: var(--text-muted); margin: 0; }

.how-icon {
  width: 40px;
  height: 40px;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ── Category pills ────────────────────────────────────────────── */
.category-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 0.6rem;
  margin: 1rem 0 2.5rem;
}

.category-pill {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.45rem 1rem;
  border-radius: 20px;
  border: 1px solid var(--border-mid);
  background: var(--bg-card);
  text-decoration: none;
  color: var(--text-muted);
  font-size: 0.85rem;
  font-weight: 600;
  transition: all 0.15s;
}

.category-pill:hover { border-color: var(--accent); color: #818cf8; transform: translateY(-1px); }

.category-pill-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--text-dim);
  flex-shrink: 0;
}

.category-pill[data-cat="Productivity"] .category-pill-dot { background: #3b82f6; }
.category-pill[data-cat="Content"]      .category-pill-dot { background: #10b981; }
.category-pill[data-cat="Design"]       .category-pill-dot { background: #8b5cf6; }
.category-pill[data-cat="Sales"]        .category-pill-dot { background: #f97316; }
.category-pill[data-cat="Customer Support"] .category-pill-dot { background: #14b8a6; }
.category-pill[data-cat="Finance"]      .category-pill-dot { background: #f59e0b; }
.category-pill[data-cat="HR"]           .category-pill-dot { background: #ec4899; }

.category-pill-count {
  font-size: 0.72rem;
  background: var(--bg-raised);
  color: var(--text-muted);
  padding: 1px 7px;
  border-radius: 10px;
  font-weight: 600;
}

@media (max-width: 720px) {
  .how-grid { grid-template-columns: 1fr; gap: 1.5rem; }
  .how-section { padding: 1.75rem; }
}
</style>

<script is:inline>
(function () {
  const canvas = document.getElementById('neural-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');

  const COUNT    = 55;
  const MAX_DIST = 115;
  let particles  = [];
  let raf;

  /* ── sizing ─────────────────────────────────────── */
  function resize() {
    const r = canvas.parentElement.getBoundingClientRect();
    canvas.width  = r.width;
    canvas.height = r.height;
  }

  /* ── spawn particles ─────────────────────────────── */
  function spawn() {
    particles = Array.from({ length: COUNT }, () => ({
      x:     Math.random() * canvas.width,
      y:     Math.random() * canvas.height,
      vx:    (Math.random() - 0.5) * 0.42,
      vy:    (Math.random() - 0.5) * 0.42,
      r:     Math.random() * 1.6 + 0.6,
      phase: Math.random() * Math.PI * 2,
    }));
  }

  /* ── pulses traveling along edges ───────────────── */
  const pulses = [];   // { i, j, t }  t: 0→1
  let  pulseTimer = 0;

  function maybeAddPulse() {
    pulseTimer++;
    if (pulseTimer < 40) return;   // every ~40 frames
    pulseTimer = 0;

    // pick a random close pair
    const close = [];
    for (let i = 0; i < particles.length; i++) {
      for (let j = i + 1; j < particles.length; j++) {
        const dx = particles[i].x - particles[j].x;
        const dy = particles[i].y - particles[j].y;
        if (dx*dx + dy*dy < (MAX_DIST * 0.65) ** 2) close.push([i, j]);
      }
    }
    if (close.length) {
      const [i, j] = close[Math.floor(Math.random() * close.length)];
      pulses.push({ i, j, t: 0 });
    }
  }

  /* ── main loop ────────────────────────────────────── */
  function loop() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);

    /* move */
    for (const p of particles) {
      p.x += p.vx;  p.y += p.vy;  p.phase += 0.017;
      if (p.x < 0 || p.x > canvas.width)  p.vx *= -1;
      if (p.y < 0 || p.y > canvas.height) p.vy *= -1;
    }

    /* connections */
    for (let i = 0; i < particles.length; i++) {
      for (let j = i + 1; j < particles.length; j++) {
        const dx = particles[i].x - particles[j].x;
        const dy = particles[i].y - particles[j].y;
        const d  = Math.sqrt(dx*dx + dy*dy);
        if (d < MAX_DIST) {
          const a = (1 - d / MAX_DIST) * 0.18;
          ctx.beginPath();
          ctx.moveTo(particles[i].x, particles[i].y);
          ctx.lineTo(particles[j].x, particles[j].y);
          ctx.strokeStyle = `rgba(129,140,248,${a})`;
          ctx.lineWidth = 0.75;
          ctx.stroke();
        }
      }
    }

    /* pulses */
    maybeAddPulse();
    for (let k = pulses.length - 1; k >= 0; k--) {
      const pulse = pulses[k];
      pulse.t += 0.018;
      if (pulse.t > 1) { pulses.splice(k, 1); continue; }

      const a = particles[pulse.i];
      const b = particles[pulse.j];
      const px = a.x + (b.x - a.x) * pulse.t;
      const py = a.y + (b.y - a.y) * pulse.t;

      const fadeAlpha = Math.sin(pulse.t * Math.PI);   // ease in-out
      const grad = ctx.createRadialGradient(px, py, 0, px, py, 6);
      grad.addColorStop(0, `rgba(200,200,255,${fadeAlpha * 0.9})`);
      grad.addColorStop(0.4, `rgba(99,102,241,${fadeAlpha * 0.5})`);
      grad.addColorStop(1,   'rgba(99,102,241,0)');
      ctx.beginPath();
      ctx.arc(px, py, 6, 0, Math.PI * 2);
      ctx.fillStyle = grad;
      ctx.fill();
    }

    /* nodes */
    for (const p of particles) {
      const pulse = (Math.sin(p.phase) + 1) / 2;   // 0–1
      const alpha = 0.3 + pulse * 0.5;
      const r     = p.r + pulse * 1.4;

      /* glow halo */
      const g = ctx.createRadialGradient(p.x, p.y, 0, p.x, p.y, r * 5);
      g.addColorStop(0, `rgba(99,102,241,${alpha * 0.28})`);
      g.addColorStop(1, 'rgba(99,102,241,0)');
      ctx.beginPath();
      ctx.arc(p.x, p.y, r * 5, 0, Math.PI * 2);
      ctx.fillStyle = g;
      ctx.fill();

      /* core */
      ctx.beginPath();
      ctx.arc(p.x, p.y, r, 0, Math.PI * 2);
      ctx.fillStyle = `rgba(165,170,255,${alpha})`;
      ctx.fill();
    }

    raf = requestAnimationFrame(loop);
  }

  /* ── init ─────────────────────────────────────────── */
  const ro = new ResizeObserver(() => { resize(); spawn(); });
  ro.observe(canvas.parentElement);
  resize();
  spawn();
  loop();

  document.addEventListener('visibilitychange', () => {
    if (document.hidden) cancelAnimationFrame(raf);
    else loop();
  });
})();
</script>
