---
const { tool } = Astro.props;
---
<div class="tool-card">
  <div class="tool-card-header">
    <img src={tool.logo} alt={tool.name} class="tool-logo" loading="lazy" />
    <div>
      <div class="tool-name">{tool.name}</div>
      <div class="tool-category">{tool.category}</div>
    </div>
  </div>
  <p class="tool-tagline">{tool.tagline}</p>
  <p class="tool-pricing">{tool.pricing}</p>
  <a href={tool.affiliateUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
    Try it free →
  </a>
</div>
